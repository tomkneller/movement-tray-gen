{
  "name": "movement-tray-gen",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.8",
    "@react-three/fiber": "^9.1.2",
    "concaveman": "^1.2.1",
    "feather-icons": "^4.29.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-feather": "^2.0.10",
    "react-tabs": "^6.1.0",
    "three": "^0.176.0",
    "three-csg-ts": "^3.2.0"
  },
  "scripts": {
    "start": "concurrently --kill-others-on-fail \"vite --configLoader runner\" \"wait-on http://localhost:5173 && electron-forge start\"",
    "dev": "vite --configLoader runner",
    "electron": "electron .",
    "build": "vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "react-start": "vite --configLoader runner",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "dist": "npm run make",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.6.1",
    "@electron-forge/maker-deb": "^7.8.1",
    "@electron-forge/maker-rpm": "^7.8.1",
    "@electron-forge/maker-squirrel": "^7.8.1",
    "@electron-forge/maker-zip": "^7.8.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.1",
    "@electron-forge/plugin-fuses": "^7.8.1",
    "@electron/fuses": "^1.8.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^9.1.2",
    "electron": "^43.2.0",
    "jsdom": "^27.0.1",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.3"
  },
  "main": "electron/main.cjs",
  "author": "Thomas Kneller",
  "description": "Movement Forge Electron Application"
